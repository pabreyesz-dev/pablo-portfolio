---
const skillCategories = [
  {
    title: "Data & BI",
    icon: "chart-bar",
    skills: [
      "SQL avanzado",
      "BigQuery",
      "Power BI (DAX, KPIs)",
      "Tableau"
    ],
    color: "blue"
  },
  {
    title: "Data Engineering",
    icon: "cog",
    skills: [
      "Python para análisis",
      "Pipelines de datos",
      "Automatización de procesos"
    ],
    color: "teal"
  },
  {
    title: "Cloud & Platform",
    icon: "cloud",
    skills: [
      "Google Cloud Platform",
      "BigQuery & Storage",
      "Cloud Processing"
    ],
    color: "indigo"
  },
  {
    title: "Backend & DB",
    icon: "database",
    skills: [
      "PostgreSQL / Oracle",
      "Modelado relacional",
      "Backend principles"
    ],
    color: "purple"
  },
  {
    title: "Herramientas",
    icon: "terminal",
    skills: [
      "Git & GitHub",
      "VS Code",
      "Documentación técnica"
    ],
    color: "slate"
  }
];

const getColorClasses = (color) => {
  const map = {
    blue: "bg-blue-50 dark:bg-blue-900/10 border-blue-100 dark:border-blue-800 text-blue-700 dark:text-blue-300",
    teal: "bg-teal-50 dark:bg-teal-900/10 border-teal-100 dark:border-teal-800 text-teal-700 dark:text-teal-300",
    indigo: "bg-indigo-50 dark:bg-indigo-900/10 border-indigo-100 dark:border-indigo-800 text-indigo-700 dark:text-indigo-300",
    purple: "bg-purple-50 dark:bg-purple-900/10 border-purple-100 dark:border-purple-800 text-purple-700 dark:text-purple-300",
    slate: "bg-slate-50 dark:bg-slate-800/50 border-slate-200 dark:border-neutral-700 text-slate-700 dark:text-slate-300",
  };
  return map[color] || map.slate;
};
---

<section id="skills" class="py-16 bg-white dark:bg-neutral-950">
  <div class="max-w-6xl mx-auto px-6">
    
    <div class="mb-12">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white mb-4">
        Habilidades Técnicas
      </h2>
      <p class="text-lg text-slate-600 dark:text-neutral-400 max-w-2xl">
        Un stack enfocado en generar valor desde el dato, soportado por una sólida base de ingeniería.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {skillCategories.map((category) => (
        <div class={`p-6 rounded-2xl border transition-all duration-300 hover:shadow-lg ${getColorClasses(category.color)}`}>
          
          <div class="flex items-center gap-4 mb-4">
            <div class="p-2 rounded-lg bg-white/50 dark:bg-black/20 backdrop-blur-sm">
               <!-- Simple Icon Switch based on name (mock logic for brevity, or inline SVGs) -->
               {category.icon === 'chart-bar' && (
                 <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
               )}
               {category.icon === 'cog' && (
                 <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
               )}
               {category.icon === 'cloud' && (
                 <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 011-7.865A7.001 7.001 0 0110 3.5v.5A7 7 0 0113.842.842a5 5 0 010 8.316A5 5 0 0114 15h-1v-4h-2l3-2.5-1-1v3.5h-1a6 6 0 00-6 6v1H3z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a4 4 0 11-8 0 4 4 0 018 0z" /></svg> // Simplified cloud
               )}
                {category.icon === 'database' && (
                 <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" /></svg>
               )}
               {category.icon === 'terminal' && (
                 <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
               )}
            </div>
            <h3 class="font-bold text-lg">{category.title}</h3>
          </div>

          <ul class="space-y-2">
            {category.skills.map((skill) => (
              <li class="flex items-start gap-2 text-sm opacity-90">
                <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-current opacity-60"></span>
                {skill}
              </li>
            ))}
          </ul>

        </div>
      ))}
    </div>

  </div>
</section>
