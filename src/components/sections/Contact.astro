---
import { Image } from 'astro:assets';

const contactInfo = [
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>',
    title: 'Email',
    value: 'pab.reyesz@gmail.com',
    link: 'mailto:pab.reyesz@gmail.com',
    action: 'Escríbeme'
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
    title: 'LinkedIn',
    value: 'Pablo Reyes Zuñiga',
    link: 'https://www.linkedin.com/in/pablo-reyes-zu%C3%B1iga/',
    action: 'Conectemos'
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>',
    title: 'Ubicación',
    value: 'Disponible Remoto y en Santiago, Chile',
    link: '#',
    action: ''
  }
];
---

<section id="contact" class="py-20 relative">
  <div class="space-y-4 mb-16 animate-fade-in-up">
    <h2 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl">
      Hablemos
    </h2>
    <p class="text-lg text-slate-600 dark:text-neutral-400 max-w-2xl text-pretty">
      ¿Tienes un proyecto de datos en mente o buscas optimizar tu inteligencia de negocios? 
      Estoy disponible para discutir cómo puedo aportar valor a tu equipo.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 animate-fade-in-up" style="animation-delay: 0.2s;">
    
    <!-- Contact Form Container -->
    <div class="bg-white dark:bg-neutral-900/50 p-6 sm:p-8 rounded-2xl border border-slate-200 dark:border-neutral-800 shadow-sm relative overflow-hidden">
      
      <!-- Success Message (Initial hidden) -->
      <div id="contact-success" class="hidden absolute inset-0 z-20 bg-white/95 dark:bg-neutral-900/98 backdrop-blur-sm flex flex-col items-center justify-center text-center p-8 transition-opacity duration-300">
        <div class="w-16 h-16 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded-full flex items-center justify-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Mensaje enviado</h3>
        <p class="text-slate-600 dark:text-neutral-400">¡Muchas gracias! Me pondré en contacto contigo pronto.</p>
        <button id="reset-form" type="button" class="mt-6 text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline">Enviar otro mensaje</button>
      </div>

      <form 
        id="contact-form"
        action="https://formspree.io/f/mzdrdlpo" 
        method="POST"
        class="space-y-6"
      >
        
        <!-- Honeypot Field (Anti-spam) -->
        <div class="hidden">
           <label for="website-honeypot">Don't fill this out if you're human:</label>
           <input name="website-bot" type="text" id="website-honeypot" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="name" class="text-sm font-medium text-slate-700 dark:text-neutral-300">Nombre</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required
              class="w-full px-4 py-3 rounded-lg bg-white dark:bg-neutral-950 border border-slate-200 dark:border-neutral-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-600 dark:focus:ring-blue-500 focus:border-transparent outline-none transition-all placeholder:text-slate-400"
              placeholder="Tu nombre"
            />
          </div>
          <div class="space-y-2">
            <label for="email" class="text-sm font-medium text-slate-700 dark:text-neutral-300">Email</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required
              class="w-full px-4 py-3 rounded-lg bg-white dark:bg-neutral-950 border border-slate-200 dark:border-neutral-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-600 dark:focus:ring-blue-500 focus:border-transparent outline-none transition-all placeholder:text-slate-400"
              placeholder="tu@email.com"
            />
          </div>
        </div>

        <div class="space-y-2">
          <label for="subject" class="text-sm font-medium text-slate-700 dark:text-neutral-300">Asunto</label>
          <input 
            type="text" 
            id="subject" 
            name="subject" 
            required
            class="w-full px-4 py-3 rounded-lg bg-white dark:bg-neutral-950 border border-slate-200 dark:border-neutral-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-600 dark:focus:ring-blue-500 focus:border-transparent outline-none transition-all placeholder:text-slate-400"
            placeholder="¿En qué puedo ayudarte?"
          />
        </div>

        <div class="space-y-2">
          <label for="message" class="text-sm font-medium text-slate-700 dark:text-neutral-300">Mensaje</label>
          <textarea 
            id="message" 
            name="message" 
            rows="4" 
            required
            class="w-full px-4 py-3 rounded-lg bg-white dark:bg-neutral-950 border border-slate-200 dark:border-neutral-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-600 dark:focus:ring-blue-500 focus:border-transparent outline-none transition-all resize-y placeholder:text-slate-400"
            placeholder="Cuéntame sobre tu proyecto o búsqueda..."
          ></textarea>
        </div>

        <button 
          id="submit-btn"
          type="submit"
          class="w-full inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-white transition-all duration-200 bg-blue-600 rounded-lg hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-500/30 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-600 focus:ring-offset-neutral-900 disabled:opacity-70 disabled:cursor-not-allowed"
        >
          <span id="btn-text">Enviar Mensaje</span>
          <svg id="btn-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 -mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
          <svg id="loading-icon" class="hidden animate-spin h-5 w-5 ml-2 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </form>
    </div>

    <!-- Contact Info Cards -->
    <div class="space-y-8">
      <div class="prose dark:prose-invert">
        <h3 class="text-xl font-semibold mb-6 text-slate-900 dark:text-white">Información de Contacto</h3>
        <p class="text-slate-600 dark:text-neutral-400 mb-8">
          Prefiero la comunicación inicial por correo electrónico o LinkedIn. Generalmente respondo en menos de 24 horas.
        </p>
      </div>

      <div class="space-y-4">
        {contactInfo.map((item) => (
          <div class="flex items-start gap-4 p-4 rounded-xl bg-white dark:bg-neutral-900 border border-slate-200 dark:border-neutral-800 shadow-sm transition-all duration-200 group hover:shadow-md hover:border-blue-500/30">
            <div class="flex-shrink-0 p-3 rounded-lg bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 group-hover:scale-110 transition-transform duration-200">
              <Fragment set:html={item.icon} />
            </div>
            <div>
              <h4 class="text-sm font-medium text-slate-900 dark:text-white mb-1">
                {item.title}
              </h4>
              <p class="text-slate-600 dark:text-neutral-400 mb-2">
                {item.value}
              </p>
              {item.action && (
                <a 
                  href={item.link}
                  target={item.link.startsWith('http') ? '_blank' : undefined}
                  rel={item.link.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 inline-flex items-center"
                >
                  {item.action}
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('contact-form');
  const successMsg = document.getElementById('contact-success');
  const submitBtn = document.getElementById('submit-btn');
  const btnText = document.getElementById('btn-text');
  const btnIcon = document.getElementById('btn-icon');
  const loadingIcon = document.getElementById('loading-icon');
  const resetBtn = document.getElementById('reset-form');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Set loading state
      submitBtn.disabled = true;
      btnText.classList.add('opacity-50');
      btnIcon.classList.add('hidden');
      loadingIcon.classList.remove('hidden');

      const formData = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          successMsg.classList.remove('hidden');
          form.reset();
        } else {
          const data = await response.json();
          if (Object.hasOwn(data, 'errors')) {
            alert(data["errors"].map(error => error["message"]).join(", "));
          } else {
            alert('Hubo un error al enviar el mensaje. Por favor intenta de nuevo.');
          }
        }
      } catch (error) {
        alert('Error de conexión. Revisa tu internet e intenta de nuevo.');
      } finally {
        // Reset loading state
        submitBtn.disabled = false;
        btnText.classList.remove('opacity-50');
        btnIcon.classList.remove('hidden');
        loadingIcon.classList.add('hidden');
      }
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      successMsg.classList.add('hidden');
    });
  }
</script>

<style>
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
