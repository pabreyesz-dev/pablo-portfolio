---
const projects = [
  {
    title: "Calu Portfolio",
    description: "Diseño y desarrollo de un portafolio web moderno y minimalista, optimizado para rendimiento y SEO.",
    tech: [
      { name: "Astro", color: "bg-orange-500/10 text-orange-400 border-orange-500/20" },
      { name: "Tailwind CSS", color: "bg-sky-500/10 text-sky-400 border-sky-500/20" },
      { name: "TypeScript", color: "bg-blue-500/10 text-blue-400 border-blue-500/20" }
    ],
    links: {
      github: "https://github.com/pabreyesz-dev/calu-portfolio",
      demo: "https://calu-portfolio.vercel.app/" // Assuming typical vercel naming or similar
    }
  },
  {
    title: "Pablo Portfolio",
    description: "Este mismo portafolio: arquitectura modular en Astro, formulario de contacto.",
    tech: [
      { name: "Astro", color: "bg-orange-500/10 text-orange-400 border-orange-500/20" },
      { name: "Tailwind CSS", color: "bg-sky-500/10 text-sky-400 border-sky-500/20" },
      { name: "Node.js", color: "bg-green-500/10 text-green-400 border-green-500/20" }
    ],
    links: {
      github: "https://github.com/pabreyesz-dev/pablo-portfolio",
      demo: "#"
    }
  },
  {
    title: "Pipeline ETL Automatizado",
    description: "Construcción de un flujo de datos desde APIs externas hacia BigQuery usando Python y Cloud Functions.",
    tech: [
      { name: "Python", color: "bg-yellow-500/10 text-yellow-400 border-yellow-500/20" },
      { name: "GCP", color: "bg-red-500/10 text-red-400 border-red-500/20" },
      { name: "BigQuery", color: "bg-teal-500/10 text-teal-400 border-teal-500/20" }
    ],
    links: {
      github: "#"
    }
  },

];
---

<section id="ingenieria" class="relative py-16 transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4">
    <!-- Section Header -->
    <div class="mb-12 space-y-4">
      <h2 
        class="text-3xl font-bold tracking-tight transition-colors"
        style="color: var(--text-primary)"
      >
        Proyectos de Ingeniería y Desarrollo
      </h2>
      <p 
        class="text-base max-w-2xl text-pretty transition-colors"
        style="color: var(--text-secondary)"
      >
        Soluciones técnicas centradas en la construcción de sistemas, automatización y desarrollo de software robusto.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <article class="relative group bg-white dark:bg-neutral-900 border border-slate-200 dark:border-neutral-800 rounded-xl overflow-hidden hover:shadow-lg transition-all duration-300 hover:border-slate-300 dark:hover:border-neutral-700">
          <div class="p-6 flex flex-col h-full gap-4">
            
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {project.title}
              </h3>
              <div class="flex gap-2">
                {project.links.github && (
                  <a 
                    href={project.links.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-1.5 text-slate-500 hover:text-slate-900 dark:text-neutral-400 dark:hover:text-white transition-colors"
                    title="Repositorio GitHub"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
                  </a>
                )}
                {project.links.demo && project.links.demo !== "#" && (
                  <a 
                    href={project.links.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-1.5 text-slate-500 hover:text-slate-900 dark:text-neutral-400 dark:hover:text-white transition-colors"
                    title="Demo / Web"
                  >
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                  </a>
                )}
              </div>
            </div>

            <p class="text-slate-600 dark:text-neutral-400 text-sm leading-relaxed flex-grow">
              {project.description}
            </p>

            <div class="flex flex-wrap gap-2 pt-2">
              {project.tech.map((t) => (
                <span class={`px-2 py-0.5 rounded text-[10px] font-mono font-medium border ${t.color}`}>
                  {t.name}
                </span>
              ))}
            </div>

          </div>
        </article>
      ))}
    </div>
  </div>
</section>
