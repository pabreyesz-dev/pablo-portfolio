---
import { Image } from 'astro:assets';

import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { projectsData } from '../../i18n/projects';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projects = projectsData[lang].dataProjects;
---

<section id="proyectos" class="relative py-20 transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4">
    <!-- Section Header -->
    <div class="mb-16 space-y-4">
      <h2 
        class="text-4xl font-bold tracking-tight transition-colors"
        style="color: var(--text-primary)"
      >
        {t('projects.title')}
      </h2>
      <p 
        class="text-lg max-w-2xl text-pretty transition-colors"
        style="color: var(--text-secondary)"
      >
        {t('projects.subtitle')}
      </p>
    </div>

    <!-- Prjects Grid -->
    <div class="grid grid-cols-1 gap-8">
      {projects.map((project) => (
        <article class="relative group bg-white dark:bg-neutral-900 border border-slate-200 dark:border-neutral-800 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 hover:border-blue-500/50 dark:hover:border-blue-500/50">
          
          <div class="p-8 md:p-10 flex flex-col gap-6">
            
            <!-- Context Header -->
             <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                <div class="space-y-2">
                   <h3 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    {project.title}
                  </h3>
                   <p class="text-slate-600 dark:text-neutral-400 text-lg leading-relaxed max-w-3xl">
                    {project.description}
                  </p>
                </div>
                 <div class="flex gap-3 shrink-0">
                  {project.links.github && (
                    <a 
                      href={project.links.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-slate-700 dark:text-neutral-300 bg-slate-100 dark:bg-neutral-800 rounded-full hover:bg-slate-200 dark:hover:bg-neutral-700 transition-colors"
                    >
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
                      Repo
                    </a>
                  )}
                  {project.links.docs && (
                    <a 
                      href={project.links.github + "#readme"}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-slate-700 dark:text-neutral-300 bg-slate-100 dark:bg-neutral-800 rounded-full hover:bg-slate-200 dark:hover:bg-neutral-700 transition-colors"
                    >
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                      Docs
                    </a>
                  )}
                 </div>
             </div>

             <!-- Details and Stack -->
             <div class="grid md:grid-cols-3 gap-8 pt-4">
                
                <!-- Key Features / Details -->
                <div class="md:col-span-2 space-y-4">
                  <h4 class="text-sm font-semibold text-slate-900 dark:text-white uppercase tracking-wider">{t('projects.details')}</h4>
                  <ul class="grid sm:grid-cols-2 gap-3 text-slate-600 dark:text-neutral-400">
                    {project.details.map((detail) => (
                      <li class="flex items-start gap-2">
                        <svg class="w-5 h-5 text-blue-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span class="text-sm">{detail}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Tech Stack -->
                <div class="space-y-4">
                  <h4 class="text-sm font-semibold text-slate-900 dark:text-white uppercase tracking-wider">{t('projects.tech')}</h4>
                  <div class="flex flex-wrap gap-2">
                    {project.tech.map((t) => (
                      <span class={`px-2.5 py-1 rounded-md text-xs font-mono font-medium border ${t.color}`}>
                        {t.name}
                      </span>
                    ))}
                  </div>
                </div>
                
             </div>

          </div>
        </article>
      ))}
    </div>
  </div>
</section>
