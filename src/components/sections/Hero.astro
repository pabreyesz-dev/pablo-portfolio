---
import { Image } from 'astro:assets';

// Define the tech stack here for easy maintenance
const techStack = [
  { name: "Python", color: "bg-[#3776AB]/10 text-[#FFD43B] border-[#3776AB]/20" },
  { name: "SQL", color: "bg-blue-500/10 text-blue-400 border-blue-500/20" },
  { name: "BigQuery", color: "bg-teal-500/10 text-teal-400 border-teal-500/20" },
  { name: "Power BI", color: "bg-yellow-500/10 text-yellow-400 border-yellow-500/20" },
  { name: "Tableau", color: "bg-purple-500/10 text-purple-400 border-purple-500/20" },
];
---

<section id="hero" class="relative flex flex-col justify-center min-h-[85vh] py-20">
  <!-- Background subtle effect (optional) -->
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-50/50 via-white to-white dark:from-neutral-800/20 dark:via-neutral-950 dark:to-neutral-950 transition-colors duration-300"></div>

  <div class="space-y-8 max-w-4xl animate-fade-in-up">
    <!-- Badge / Role Indicator -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 dark:bg-neutral-900 dark:border-neutral-800 text-slate-800 dark:text-neutral-300 text-sm font-medium w-fit transition-colors">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
      </span>
      Disponible para nuevos proyectos
    </div>

    <!-- Main Headline -->
    <div class="space-y-4">
      <!-- Forced CSS Variable Color for absolute reliability -->
      <h1 
        class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.1] transition-colors"
        style="color: var(--text-primary)"
      >
        Analista de Datos e <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-teal-600 dark:from-blue-400 dark:to-teal-400">
          Ingeniero de BI
        </span>
      </h1>
      
      <h2 
        class="text-xl md:text-2xl font-medium max-w-2xl text-pretty transition-colors"
        style="color: var(--text-secondary)"
      >
        Transformo datos complejos en activos estratégicos para la toma de decisiones.
      </h2>
    </div>

    <!-- Description -->
    <p 
      class="text-lg max-w-2xl leading-relaxed text-pretty transition-colors"
      style="color: var(--text-secondary)"
    >
      Soluciones integrales: desde la extracción y el modelado técnico, hasta la visualización de alto impacto que impulsa el negocio.
    </p>

    <!-- Tech Stack Mini-indicators -->
    <div class="flex flex-wrap gap-3">
      {techStack.map((tech) => (
        <span class={`px-3 py-1 rounded-md text-sm font-mono border ${tech.color}`}>
          {tech.name}
        </span>
      ))}
    </div>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center gap-4 pt-4">
      <a 
        href="#proyectos" 
        class="group relative inline-flex items-center justify-center px-8 py-3 text-base font-semibold text-white transition-all duration-200 bg-blue-600 rounded-lg hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-500/30 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-600 focus:ring-offset-neutral-900 w-full sm:w-auto"
      >
        Explorar Portfolio
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 -mr-1 transition-transform group-hover:translate-y-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>

      <div class="flex items-center gap-4 w-full sm:w-auto justify-center sm:justify-start">
        <a 
          href="https://www.linkedin.com/in/pablo-reyes-zu%C3%B1iga/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-slate-700 dark:text-neutral-200 transition-colors duration-200 border border-slate-300 dark:border-neutral-700 rounded-lg hover:bg-slate-50 dark:hover:bg-neutral-800 hover:text-blue-600 dark:hover:text-blue-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-500"
        >
          <svg class="w-5 h-5 mr-2 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          Conectar
        </a>

         <!-- GitHub Icon (tertiary/discrete) -->
        <a 
          href="https://github.com/pabreyesz-dev" 
          target="_blank" 
          rel="noopener noreferrer"
          class="p-3 text-slate-500 dark:text-neutral-500 hover:text-black dark:hover:text-white transition-colors"
          aria-label="GitHub"
        >
          <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 fill-current"><title>GitHub</title><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.896-.015 3.286 0 .315.216.694.825.576C20.566 22.091 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        </a>
      </div>
    </div>
    
    <!-- Contact Text CTA -->
    <div class="pt-2 text-center sm:text-left animate-fade-in-up" style="animation-delay: 0.2s;">
      <span class="text-slate-600 dark:text-neutral-400">¿Buscas colaboración? </span>
      <a href="/contact" class="inline-flex items-center font-medium text-blue-600 dark:text-blue-400 hover:underline hover:text-blue-700 dark:hover:text-blue-300 transition-colors">
        Hablemos
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* Simple fade-in animation */
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
